{
    "name": "Go DevContainer (Ubuntu 24.04)",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash"
            },
            "extensions": [
                "golang.Go",
                "kilocode.kilo-code",
                "GitHub.copilot"
            ]
        }
    },
    "postCreateCommand": "go version",
    "remoteUser": "ubuntu"
}
